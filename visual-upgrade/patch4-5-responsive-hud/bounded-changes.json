\" data-control=\"brake\" aria-label=\"Rem\" id=\"brakeControl\"></button><button class=\"rq-control touch-btn\" data-control=\"gas\" aria-label=\"Gas\" id=\"gasControl\"></button></div>\n  <div id=\"speedLines\" class=\"speed-lines\" hidden></div>\n  <div id=\"hudLegacy\" hidden><div id=\"raceNotice\" hidden></div><div id=\"raceJumpHint\"></div><div id=\"hudBuff\"></div></div>\n </div>\n</section>"
