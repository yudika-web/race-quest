    "new": "<section id=\"race\" class=\"screen\" hidden aria-label=\"Balapan\" data-controls=\"keyboard\">\n <div class=\"rq-layout\" id=\"hudLayout\">\n  <header class=\"rq-top\">\n   <section class=\"rq-card rq-summary\" aria-label=\"Posisi dan waktu\">\n    <div class=\"rq-position\"><small>POSISI</small><div><strong id=\"hudRank\">1</strong><span>/5</span></div></div>\n    <div class=\"rq-timing\"><small id=\"hudLap\">PUTARAN 1 / 3</small><b id=\"hudTime\">00:00.0</b><small id=\"hudLapTime\">Lap — · PB —</small><small id=\"hudGap\" class=\"rq-optional\">Ke depan —</small></div>\n    <div id=\"raceBankLabel\" class=\"rq-stage\">Stage</div>\n   </section>\n   <section class=\"rq-card rq-mission\" aria-label=\"Progres soal\"><div><b id=\"hudQuestion\">SOAL 1 / 5</b><small id=\"hudGate\">Menuju pos soal</small></div><div class=\"rq-progress\" role=\"progressbar\" id=\"hudQuestionProgress\" aria-label=\"Menuju pos soal berikutnya\" aria-valuemin=\"0\" aria-valuemax=\"100\"><i id=\"hudProgress\"></i></div></section>\n   <nav class=\"rq-toolbar\" aria-label=\"Toolbar balapan\">\n    <button data-act=\"audio\" aria-label=\"Pengaturan suara dan kontrol\" title=\"Suara & kontrol\"><svg viewBox=\"0 0 24 24\"><path d=\"m11 5-6 4H2v6h3l6 4Zm4 3a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14\"/></svg></button>\n    <button data-act=\"restartRace\" aria-label=\"Mulai ulang balapan\" title=\"Mulai ulang balapan\"><svg viewBox=\"0 0 24 24\"><path d=\"M4 10a8 8 0 1 1 1 8M4 4v6h6\"/></svg></button>\n    <button data-act=\"fullscreen\" aria-label=\"Layar penuh\" title=\"Layar penuh\"><svg viewBox=\"0 0 24 24\"><path d=\"M9 3H3v6m12-6h6v6M3 15v6h6m6 0h6v-6\"/></svg></button>\n    <button data-act=\"pause\" aria-label=\"Jeda balapan\" title=\"Jeda · Esc / P\" id=\"pauseRaceBtn\"></button>\n   </nav>\n   <div id=\"hudNotice\" class=\"rq-notice\" role=\"status\" aria-live=\"polite\" hidden></div>\n  </header>\n  <section class=\"rq-inventory-dock\" id=\"inventoryDock\" aria-label=\"Inventori dua